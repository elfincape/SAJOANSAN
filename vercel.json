{
  "framework": null,
  "installCommand": "npm ci --omit=dev && cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "redirects": [
    {
      "source": "/admin/talkcloud",
      "destination": "https://211.233.219.199:8443/",
      "permanent": false
    }
  ],
  "functions": {
    "api/erp-course-catalog.mjs": {
      "maxDuration": 60
    },
    "api/private-mail-worker.mjs": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 240
    },
    "api/private-mail-diagnostic.mjs": {
      "maxDuration": 30
    },
    "api/private-mail-collect.mjs": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 240
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/legacy-web-structure-fix": false
    }
  }
}
